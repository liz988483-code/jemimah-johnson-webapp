# Copy to .env next to docker-compose.yml before `docker compose up -d --build`.
# docker compose reads this automatically to fill the ${VAR} references in
# docker-compose.yml -- no --env-file flag needed.
# DB_HOST/DB_PORT/DB_DIALECT aren't listed here: they're fixed in docker-compose.yml
# itself (db / 5432 / postgres), since the db service is defined right there too.

# Database
DB_NAME=jemimah_johnson
DB_USER=jemimah_johnson_user
DB_PASSWORD=change-me

# JWT
JWT_SECRET=change-me-super-secret
JWT_EXPIRE=30d

# Admin login
ADMIN_EMAIL=admin@jemimahjohnson.com
ADMIN_PASSWORD=change-me

# Must match the domain in embrace-proxy's Caddyfile
FRONTEND_URL=https://jemimahandassociates.com
CORS_ORIGINS=https://jemimahandassociates.com,https://www.jemimahandassociates.com

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@jemimahjohnson.com

# M-Pesa (optional)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=https://jemimahandassociates.com/api/mpesa/callback

# Document encryption
ENCRYPTION_KEY=change-me-32-byte-hex-key
