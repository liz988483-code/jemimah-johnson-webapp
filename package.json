{
  "name": "jemimah-johnson-webapp",
  "version": "1.0.0",
  "description": "Jemimah Johnson and Associates - Professional Business Services",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd . && vite --host 0.0.0.0",
    "dev:backend": "cd backend && nodemon --exec \"ts-node --project tsconfig.json\" server.ts",
    "backend": "cd backend && nodemon --exec \"ts-node --project tsconfig.json\" server.ts",
    "build": "vite build",
    "build:backend": "cd backend && tsc",
    "preview": "vite preview",
    "start": "node backend/dist/server.js",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@types/multer": "^2.1.0",
    "autoprefixer": "^10.4.14",
    "axios": "^1.16.0",
    "bcryptjs": "^2.4.0",
    "cors": "^2.8.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-validator": "^6.14.0",
    "framer-motion": "^10.0.0",
    "helmet": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "^0.263.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "mysql2": "^3.6.0",
    "nodemailer": "^6.9.0",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "postcss": "^8.4.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "recharts": "^3.8.1",
    "sequelize": "^6.32.0",
    "tailwindcss": "^3.2.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/morgan": "^1.9.4",
    "@types/node": "^18.14.6",
    "@types/nodemailer": "^6.4.7",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@vitejs/plugin-react": "^3.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.35.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "nodemon": "^2.0.20",
    "sequelize-cli": "^6.6.5",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.3",
    "vite": "^4.1.0"
  },
  "keywords": [
    "business",
    "accounting",
    "company-registration",
    "consulting",
    "react",
    "typescript"
  ],
  "author": "Jemimah Johnson and Associates",
  "license": "MIT"
}
